{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free My TV Studio",
  "version": "0.1.0",
  "identifier": "io.github.fellipelyra.freemytv.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5610",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5610 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Free My TV Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Free My TV",
    "shortDescription": "Editor visual de layouts para o Free My TV",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
